{
    "name": "snowsync",
    "version": "0.0.0",
    "private": true,
    "description": "SnowSync: Sacramento State Ski & Snow Club mobile app (monorepo root)",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "engines": {
        "node": ">=24.11.0 <25"
    },
    "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:server": "npm run dev --workspace @snowsync/server",
    "mobile": "npm run start --workspace @snowsync/mobile"
  },
}