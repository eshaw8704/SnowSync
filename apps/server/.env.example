# Copy this file to apps/server/.env when setting up the server. Keep .env out of git.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Matches the postgres service in /docker-compose.yml
DATABASE_URL=postgresql://snowsync:snowsync@localhost:5432/snowsync?schema=public
# Signs access tokens. Use a different long random value on every machine and server, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Password-reset emails link here (the app's deep link). In development the email is printed in the server log.
PASSWORD_RESET_URL=snowsync://reset-password
EMAIL_FROM=SnowSync <no-reply@snowsync.local>
# console = print emails in the server log (development). ses = send through Amazon SES (production).
EMAIL_TRANSPORT=console
AWS_REGION=us-west-2
# How often the trip Scheduler checks for due lifecycle transitions.
SCHEDULER_INTERVAL_SECONDS=30
# Sac State SSO (OpenID Connect). Leave these empty until Sac State IT issues the client: SSO stays off.
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=
SSO_APP_REDIRECT_URL=snowsync://sso-complete