{
  "name": "@snowsync/server",
  "version": "0.0.0",
  "private": true,
  "description": "SnowSync backend: one Node.js + TypeScript modular monolith",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@snowsync/shared": "*",
    "dotenv": "^18.0.0",
    "express": "^5.3.0",
    "jose": "^6.2.0",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.0",
    "vitest": "^5.0.0"
  }
}
