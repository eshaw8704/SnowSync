// SnowSync database schema (Prisma ORM 7).
// Model and field names are camelCase in TypeScript and snake_case in PostgreSQL (@map / @@map).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Club-level role, lowest rank first. Must match UserRole in @snowsync/shared.
enum UserRole {
  MEMBER
  OFFICER
  TREASURER
  VICE_PRESIDENT
  PRESIDENT

  @@map("user_role")
}

/// Club membership of one account. Must match MembershipStatus in @snowsync/shared.
enum MembershipStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NOT_AUTHORIZED
  DEACTIVATED

  @@map("membership_status")
}

/// Trip lifecycle (System Map §05). Must match TripState in @snowsync/shared.
enum TripState {
  CREATED
  OPEN_FOR_REGISTRATION
  CHECK_IN
  ACTIVE
  EXIT
  COMPLETED
  CANCELLED

  @@map("trip_state")
}

/// One member's participation in one trip. Must match ParticipationState in @snowsync/shared.
enum ParticipationState {
  NOT_REGISTERED
  REGISTERED
  CHECKED_IN
  ACTIVE
  CHECKED_OUT
  NO_SHOW
  LEFT_EARLY

  @@map("participation_state")
}

/// Who caused a trip transition: an officer, the Scheduler, or a business rule.
enum TransitionActorType {
  USER
  SCHEDULER
  RULE

  @@map("transition_actor_type")
}

/// Activity a member prefers. Must match PREFERRED_ACTIVITIES in @snowsync/shared.
enum PreferredActivity {
  SKIING
  SNOWBOARDING
  BOTH

  @@map("preferred_activity")
}

/// One SnowSync account. An account is not a membership: see membershipStatus.
model User {
  id                        String             @id @default(uuid()) @db.Uuid
  email                     String             @unique
  displayName               String             @map("display_name")
  role                      UserRole           @default(MEMBER)
  /// argon2id hash. Null for accounts that only use Sac State SSO (Sprint 4).
  passwordHash              String?            @map("password_hash")
  failedSignInCount         Int                @default(0) @map("failed_sign_in_count")
  signInLockedUntil         DateTime?          @map("sign_in_locked_until") @db.Timestamptz(3)
  membershipStatus          MembershipStatus   @default(PENDING_APPROVAL) @map("membership_status")
  membershipRequestedAt     DateTime           @default(now()) @map("membership_requested_at") @db.Timestamptz(3)
  membershipDecidedAt       DateTime?          @map("membership_decided_at") @db.Timestamptz(3)
  membershipDecidedById     String?            @map("membership_decided_by_id") @db.Uuid
  membershipRejectionReason String?            @map("membership_rejection_reason")
  preferredActivity         PreferredActivity? @map("preferred_activity")
  onboardingCompletedAt     DateTime?          @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emergencyContact        EmergencyContact?
  notificationPreferences NotificationPreferences?
  clubCodesCreated        ClubCode[]               @relation("ClubCodeCreatedBy")
  clubCodesUsed           ClubCode[]               @relation("ClubCodeUsedBy")
  auditLogs               AuditLog[]
  tripsCreated            Trip[]                   @relation("TripCreatedBy")
  tripMemberships         TripMembership[]         @relation("TripMembershipUser")
  tripRegistrationsAdded  TripMembership[]         @relation("TripMembershipRegisteredBy")

  @@index([membershipStatus])
  @@map("users")
}

/// One refresh token. Only its SHA-256 hash is stored. Rotation keeps one family per sign-in.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One single-use password-reset link. Only its SHA-256 hash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One-time club code created by an officer. Only its SHA-256 hash is stored.
model ClubCode {
  id          String    @id @default(uuid()) @db.Uuid
  codeHash    String    @unique @map("code_hash")
  createdById String    @map("created_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  usedById    String?   @map("used_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User  @relation("ClubCodeCreatedBy", fields: [createdById], references: [id])
  usedBy    User? @relation("ClubCodeUsedBy", fields: [usedById], references: [id])

  @@map("club_codes")
}

/// Emergency contact: a separate, access-controlled table, never part of the public profile.
model EmergencyContact {
  userId       String   @id @map("user_id") @db.Uuid
  name         String
  relationship String
  phone        String
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

/// Optional-update choices. Trip-critical and safety notices are always delivered.
model NotificationPreferences {
  userId            String   @id @map("user_id") @db.Uuid
  tripReminders     Boolean  @default(true) @map("trip_reminders")
  clubAnnouncements Boolean  @default(true) @map("club_announcements")
  fundraisers       Boolean  @default(false)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// An executive's override of one permission for MEMBER or OFFICER. No row = shared default.
model RolePermission {
  role        UserRole
  permission  String
  granted     Boolean
  updatedById String   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([role, permission])
  @@map("role_permissions")
}

/// Every administrative change: who, what, when, why, and the before/after values.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One club trip. All times are UTC instants; resortTimeZone is used only for display.
model Trip {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  description          String    @default("")
  resortName           String    @map("resort_name")
  resortTimeZone       String    @map("resort_time_zone")
  startsAt             DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime  @map("ends_at") @db.Timestamptz(3)
  capacity             Int
  costCents            Int       @map("cost_cents")
  state                TripState @default(CREATED)
  /// Starts at 1; every edit and every transition adds 1. Edits must send the version they loaded.
  version              Int       @default(1)
  registrationOpensAt  DateTime  @map("registration_opens_at") @db.Timestamptz(3)
  registrationClosesAt DateTime  @map("registration_closes_at") @db.Timestamptz(3)
  checkInStartsAt      DateTime  @map("check_in_starts_at") @db.Timestamptz(3)
  sessionStartsAt      DateTime  @map("session_starts_at") @db.Timestamptz(3)
  exitStartsAt         DateTime  @map("exit_starts_at") @db.Timestamptz(3)
  createdById          String    @map("created_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User             @relation("TripCreatedBy", fields: [createdById], references: [id])
  geofence    TripGeofence?
  transitions TripTransition[]
  memberships TripMembership[]

  @@index([state])
  @@index([startsAt])
  @@map("trips")
}

/// The circle around the base lodge that automatic check-in uses (Sprint 6).
model TripGeofence {
  id           String @id @default(uuid()) @db.Uuid
  tripId       String @unique @map("trip_id") @db.Uuid
  latitude     Float
  longitude    Float
  radiusMeters Int    @map("radius_meters")
  label        String

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_geofences")
}

/// Every trip state change: who or what caused it, why, and the opId that makes it idempotent.
model TripTransition {
  id        String              @id @default(uuid()) @db.Uuid
  tripId    String              @map("trip_id") @db.Uuid
  fromState TripState           @map("from_state")
  toState   TripState           @map("to_state")
  actorType TransitionActorType @map("actor_type")
  actorId   String?             @map("actor_id") @db.Uuid
  reason    String?
  opId      String              @unique @map("op_id")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_transitions")
}

/// One member's participation in one trip. Independent of the trip's own state.
model TripMembership {
  id             String             @id @default(uuid()) @db.Uuid
  tripId         String             @map("trip_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  participation  ParticipationState @default(REGISTERED)
  registeredAt   DateTime           @default(now()) @map("registered_at") @db.Timestamptz(3)
  registeredById String?            @map("registered_by_id") @db.Uuid
  version        Int                @default(1)

  trip         Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User  @relation("TripMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  registeredBy User? @relation("TripMembershipRegisteredBy", fields: [registeredById], references: [id])

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_memberships")
}