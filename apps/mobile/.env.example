# Copy to apps/mobile/.env (git-ignored). Restart `npm run mobile` after changing it.
# Leave EXPO_PUBLIC_API_URL unset to use the defaults:
#   iOS simulator    → http://localhost:3000
#   Android emulator → http://10.0.2.2:3000
# On a physical phone, set it to your computer's LAN address, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
# Sac State SSO (SS-38). Keep false until Sac State IT approves the integration and the server has
# SSO_ISSUER_URL, SSO_CLIENT_ID, SSO_CLIENT_SECRET and SSO_CALLBACK_URL set. With the flag on and
# the server unconfigured, the browser shows a 404 page and the app reports the sign-in as cancelled.
# SSO needs a development build (`npx expo run:ios` / `run:android`): Expo Go does not register the
# snowsync:// scheme, so the browser cannot hand the sign-in back to the app.
EXPO_PUBLIC_SSO_ENABLED=false