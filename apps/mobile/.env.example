# Copy to apps/mobile/.env (git-ignored). Restart `npm run mobile` after changing it.
# Leave EXPO_PUBLIC_API_URL unset to use the defaults:
#   iOS simulator    → http://localhost:3000
#   Android emulator → http://10.0.2.2:3000
# On a physical phone, set it to your computer's LAN address, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:3000